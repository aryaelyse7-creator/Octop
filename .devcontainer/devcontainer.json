{
  "name": "Octop",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "20"
    },
    "ghcr.io/devcontainers/features/desktop-lite:1": {
      "webPort": "6080",
      "vncPort": "5901"
    }
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "forwardPorts": [6080, 5901, 8000, 9222],
  "portsAttributes": {
    "6080": { "label": "Desktop (noVNC — watch the browser live)" },
    "5901": { "label": "Desktop VNC" },
    "8000": { "label": "Octop server", "onAutoForward": "notify" },
    "9222": { "label": "Chrome CDP" }
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "charliermarsh.ruff", "ms-playwright.playwright"]
    }
  }
}
